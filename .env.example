# Supabase (Lovable Cloud)
# Публичные значения проекта: URL и publishable (anon) ключ.
SUPABASE_PROJECT_ID=your-supabase-project-id
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

VITE_SUPABASE_PROJECT_ID=your-supabase-project-id
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# ВНИМАНИЕ:
# - Не храните здесь реальные ключи, пароли и токены.
# - SUPABASE_SERVICE_ROLE_KEY здесь быть не должен: он только серверный
#   и задаётся в настройках окружения, а не в репозитории.
# - Скопируйте этот файл в .env и заполните значения локально.
